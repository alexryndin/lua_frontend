profile lua55;
version "5.5.0";
contextual "global";

rule chunk = block:body EOF => Chunk(body);
rule repl_expr = exp:value EOF => Chunk(Block(Return(ExprList(value))));
rule block = { stat:items } [ retstat:ret ] => Block(items, ret);

rule stat = empty_stat | global_function_stat | global_decl | global_all | assign_stat | call_stat | label_stat | break_stat | goto_stat | do_stat | while_stat | repeat_stat | if_stat | numeric_for_stat | generic_for_stat | function_stat | local_function_stat | local_decl;
rule empty_stat = ";" => Empty();
rule assign_stat = varlist:left "=" explist:right => Assign(left, right);
rule call_stat = postfix:call => Pass(call);
rule label_stat = "::" NAME:name "::" => Label(name);
rule break_stat = "break" => Break();
rule goto_stat = "goto" NAME:name => Goto(name);
rule do_stat = "do" block:body "end" => Do(body);
rule while_stat = "while" exp:cond "do" block:body "end" => While(cond, body);
rule repeat_stat = "repeat" block:body "until" exp:cond => Repeat(body, cond);
rule if_stat = "if" exp:cond "then" block:yes { elseif_part:elifs } [ else_part:no ] "end" => If(cond, yes, elifs, no);
rule elseif_part = "elseif" exp:cond "then" block:body => ElseIf(cond, body);
rule else_part = "else" block:body => Else(body);
rule numeric_for_stat = "for" NAME:name "=" exp:first "," exp:last [ "," exp:step ] "do" block:body "end" => NumericFor(name, first, last, step, body);
rule generic_for_stat = "for" namelist:names "in" explist:values "do" block:body "end" => GenericFor(names, values, body);
rule function_stat = "function" funcname:name funcbody:body => FunctionDecl(name, body);
rule local_function_stat = "local" "function" NAME:name funcbody:body => LocalFunction(name, body);
rule global_function_stat = "global" "function" NAME:name funcbody:body => GlobalFunction(name, body);
rule local_decl = "local" attnamelist:names [ "=" explist:values ] => Local(names, values);
rule global_decl = "global" attnamelist:names [ "=" explist:values ] => Global(names, values);
rule global_all = "global" [ attrib:attr ] "*" => GlobalAll(attr);

rule retstat = "return" [ explist:values ] [ ";" ] => Return(values);
rule namelist = NAME:first { "," NAME:rest } => ParamList(first, rest);
rule attnamelist = [ attrib:prefix ] attname:first { "," attname:rest } => DeclList(prefix, first, rest);
rule attname = NAME:name [ attrib:attr ] => DeclName(name, attr);
rule attrib = "<" NAME:name ">" => Attr(name);
rule varlist = postfix:first { "," postfix:rest } => VarList(first, rest);
rule explist = exp:first { "," exp:rest } => ExprList(first, rest);

rule exp = or_expr:value => Pass(value);
rule or_expr = and_expr:first { or_tail:rest } => Fold(first, rest);
rule or_tail = "or":op and_expr:value => Tail(op, value);
rule and_expr = compare_expr:first { and_tail:rest } => Fold(first, rest);
rule and_tail = "and":op compare_expr:value => Tail(op, value);
rule compare_expr = bor_expr:first { compare_tail:rest } => Fold(first, rest);
rule compare_tail = compop:op bor_expr:value => Tail(op, value);
rule compop = "<" | "<=" | ">" | ">=" | "==" | "~=";
rule bor_expr = bxor_expr:first { bor_tail:rest } => Fold(first, rest);
rule bor_tail = "|":op bxor_expr:value => Tail(op, value);
rule bxor_expr = band_expr:first { bxor_tail:rest } => Fold(first, rest);
rule bxor_tail = "~":op band_expr:value => Tail(op, value);
rule band_expr = shift_expr:first { band_tail:rest } => Fold(first, rest);
rule band_tail = "&":op shift_expr:value => Tail(op, value);
rule shift_expr = concat_expr:first { shift_tail:rest } => Fold(first, rest);
rule shift_tail = shiftop:op concat_expr:value => Tail(op, value);
rule shiftop = "<<" | ">>";
rule concat_expr = add_expr:left [ concat_tail:right ] => Right(left, right);
rule concat_tail = "..":op concat_expr:value => Tail(op, value);
rule add_expr = mul_expr:first { add_tail:rest } => Fold(first, rest);
rule add_tail = addop:op mul_expr:value => Tail(op, value);
rule addop = "+" | "-";
rule mul_expr = unary_expr:first { mul_tail:rest } => Fold(first, rest);
rule mul_tail = mulop:op unary_expr:value => Tail(op, value);
rule mulop = "*" | "/" | "//" | "%";
rule unary_expr = unary_pref | pow_expr;
rule unary_pref = unop:op unary_expr:value => Unary(op, value);
rule unop = "-" | "not" | "#" | "~";
rule pow_expr = simple_expr:left [ pow_tail:right ] => Right(left, right);
rule pow_tail = "^":op unary_expr:value => Tail(op, value);

rule simple_expr = nil_expr | false_expr | true_expr | number_expr | string_expr | vararg_expr | functiondef | tableconstructor | postfix;
rule nil_expr = "nil" => Nil();
rule false_expr = "false" => Bool("false");
rule true_expr = "true" => Bool("true");
rule number_expr = NUMBER:value => Pass(value);
rule string_expr = STRING:value => Pass(value);
rule vararg_expr = "..." => Vararg();

rule postfix = primary:base { suffix:tail } => Postfix(base, tail);
rule primary = name_primary | paren_primary;
rule name_primary = NAME:name => Pass(name);
rule paren_primary = "(" exp:value ")" => Paren(value);
rule suffix = index_suffix | field_suffix | method_suffix | call_suffix;
rule index_suffix = "[" exp:key "]" => IndexSuffix(key);
rule field_suffix = "." NAME:name => FieldSuffix(name);
rule method_suffix = ":" NAME:name args:args => MethodSuffix(name, args);
rule call_suffix = args:args => CallSuffix(args);

rule args = paren_args | table_args | string_args;
rule paren_args = "(" [ explist:values ] ")" => Pass(values);
rule table_args = tableconstructor:value => Pass(value);
rule string_args = STRING:value => Pass(value);

rule functiondef = "function" funcbody:body => FunctionExpr(body);
rule funcname = NAME:first { funcfield:rest } [ funcmethod:method ] => FuncName(first, rest, method);
rule funcfield = "." NAME:name => FuncField(name);
rule funcmethod = ":" NAME:name => FuncMethod(name);
rule funcbody = "(" [ parlist:params ] ")" block:body "end" => FunctionBody(params, body);
rule parlist = named_parlist | vararg_parlist;
rule named_parlist = namelist:names [ "," varargparam:vararg ] => Params(names, vararg);
rule vararg_parlist = varargparam:vararg => Params(vararg);
rule varargparam = "..." [ NAME:name ] => Vararg(name);

rule tableconstructor = "{" [ fieldlist:fields ] "}" => Table(fields);
rule fieldlist = field:first { field_tail:rest } [ fieldsep ] => List(first, rest);
rule field_tail = fieldsep field:value => Pass(value);
rule field = keyed_field | named_field | value_field;
rule keyed_field = "[" exp:key "]" "=" exp:value => KeyedField(key, value);
rule named_field = NAME:name "=" exp:value => NamedField(name, value);
rule value_field = exp:value => ValueField(value);
rule fieldsep = "," | ";";
