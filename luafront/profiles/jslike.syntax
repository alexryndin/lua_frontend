profile jslike;
version "1.0.0";

rule chunk = block:body EOF => Chunk(body);
rule repl_expr = exp:value EOF => Chunk(Block(Return(ExprList(value))));
rule block = { stat:items } => Block(items);
rule braced_block = "{" block:body "}" => Pass(body);

rule stat = empty_stat | local_decl | function_stat | if_stat | while_stat | return_stat | break_stat | assign_stat | call_stat;
rule empty_stat = ";" => Empty();
rule local_decl = "let" NAME:name [ "=" exp:value ] ";" => Local(DeclList(DeclName(name)), ExprList(value));
rule function_stat = "function" NAME:name js_funcbody:body => FunctionDecl(FuncName(name), body);
rule if_stat = "if" "(" exp:cond ")" braced_block:yes [ else_part:no ] => If(cond, yes, no);
rule else_part = "else" braced_block:body => Else(body);
rule while_stat = "while" "(" exp:cond ")" braced_block:body => While(cond, body);
rule return_stat = "return" [ explist:values ] ";" => Return(values);
rule break_stat = "break" ";" => Break();
rule assign_stat = varlist:left "=" explist:right ";" => Assign(left, right);
rule call_stat = postfix:call ";" => Pass(call);

rule namelist = NAME:first { name_tail:rest } => ParamList(first, rest);
rule name_tail = "," NAME:name => Pass(name);
rule varlist = postfix:first { var_tail:rest } => VarList(first, rest);
rule var_tail = "," postfix:value => Pass(value);
rule explist = exp:first { exp_tail:rest } => ExprList(first, rest);
rule exp_tail = "," exp:value => Pass(value);

rule exp = or_expr:value => Pass(value);
rule or_expr = and_expr:first { or_tail:rest } => Fold(first, rest);
rule or_tail = "||":op and_expr:value => Tail("or", value);
rule and_expr = compare_expr:first { and_tail:rest } => Fold(first, rest);
rule and_tail = "&&":op compare_expr:value => Tail("and", value);
rule compare_expr = add_expr:first { compare_tail:rest } => Fold(first, rest);
rule compare_tail = compop:op add_expr:value => Tail(op, value);
rule compop = lt_op | le_op | gt_op | ge_op | eq_op | ne_op;
rule lt_op = "<" => Pass("<");
rule le_op = "<=" => Pass("<=");
rule gt_op = ">" => Pass(">");
rule ge_op = ">=" => Pass(">=");
rule eq_op = "==" => Pass("==");
rule ne_op = "!=" => Pass("~=");
rule add_expr = mul_expr:first { add_tail:rest } => Fold(first, rest);
rule add_tail = addop:op mul_expr:value => Tail(op, value);
rule addop = "+" | "-";
rule mul_expr = unary_expr:first { mul_tail:rest } => Fold(first, rest);
rule mul_tail = mulop:op unary_expr:value => Tail(op, value);
rule mulop = "*" | "/" | "%";
rule unary_expr = unary_pref | pow_expr;
rule unary_pref = unop:op unary_expr:value => Unary(op, value);
rule unop = neg_op | not_op | len_op | bnot_op;
rule neg_op = "-" => Pass("-");
rule not_op = "!" => Pass("not");
rule len_op = "#" => Pass("#");
rule bnot_op = "~" => Pass("~");
rule pow_expr = simple_expr:left [ pow_tail:right ] => Right(left, right);
rule pow_tail = "^":op unary_expr:value => Tail(op, value);

rule simple_expr = null_expr | false_expr | true_expr | number_expr | string_expr | functiondef | tableconstructor | postfix;
rule null_expr = "null" => Nil();
rule false_expr = "false" => Bool("false");
rule true_expr = "true" => Bool("true");
rule number_expr = NUMBER:value => Pass(value);
rule string_expr = STRING:value => Pass(value);

rule postfix = primary:base { suffix:tail } => Postfix(base, tail);
rule primary = name_primary | paren_primary;
rule name_primary = NAME:name => Pass(name);
rule paren_primary = "(" exp:value ")" => Paren(value);
rule suffix = index_suffix | field_suffix | call_suffix;
rule index_suffix = "[" exp:key "]" => IndexSuffix(key);
rule field_suffix = "." NAME:name => FieldSuffix(name);
rule call_suffix = args:args => CallSuffix(args);
rule args = "(" [ explist:values ] ")" => Pass(values);
rule functiondef = "function" js_funcbody:body => FunctionExpr(body);
rule js_funcbody = "(" [ namelist:params ] ")" braced_block:body => FunctionBody(Params(params), body);
rule tableconstructor = "{" [ fieldlist:fields ] "}" => Table(fields);
rule fieldlist = field:first { field_tail:rest } [ "," ] => List(first, rest);
rule field_tail = "," field:value => Pass(value);
rule field = named_field | keyed_field | value_field;
rule named_field = NAME:name ":" exp:value => NamedField(name, value);
rule keyed_field = "[" exp:key "]" ":" exp:value => KeyedField(key, value);
rule value_field = exp:value => ValueField(value);
